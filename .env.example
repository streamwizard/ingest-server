# ============================================================
# StreamWizard Ingest Server — Environment Variables
# Copy this file to .env and fill in your values.
# The claim flow (scripts/install.sh --rest-api-url/--token) writes all of these
# for you; see docs/PANEL_INTEGRATION.md.
# ============================================================

# General
NODE_ENV=development

# ── Panel rest-api ───────────────────────────────────────────
# ingest-control reads and writes sessions through the panel's rest-api
# (/api/ingest-nodes/*), which also issues the short-lived token and URL for
# its ws-server socket. It holds no database or ws-server credentials. e.g. http://localhost:3001 locally
REST_API_URL=

# This node's API key, returned once by the claim flow. Only its hash is
# stored on the panel side — keep it secret.
NODE_API_KEY=

# ── Internal Auth ────────────────────────────────────────────
# Shared secret the media plane must present on every internal call.
# Generate with: openssl rand -hex 32
INGEST_CONTROL_SECRET=

# ── Fleet identity ───────────────────────────────────────────
# ingest_nodes.id, returned by the claim flow (docs/PANEL_INTEGRATION.md).
# Tags this node's host system metrics (CPU/RAM/bandwidth) in InfluxDB.
INGEST_NODE_ID=

# ── ingest-control ───────────────────────────────────────────
# HTTP port for the control plane (default: 8090)
PORT=8090

# ── ingest-media ─────────────────────────────────────────────
# Base URL of the control plane reachable from the media container.
# e.g. http://localhost:8090 locally or http://ingest-control:8090 in Docker.
INGEST_CONTROL_URL=

# Public SRT ingest port (streamers connect here)
INGEST_SRT_PORT=8888
# Internal SRT port for Belabox srtla_receiver connections
INGEST_SRTLA_SRT_PORT=8889
# SRT output port OBS pulls from (bound to Tailscale interface in prod)
INGEST_OUTPUT_PORT=9000
# SRT receiver-buffer latency (ms) on the ingress listeners (phone -> server,
# cellular): big retransmit budget. Legacy name INGEST_SRT_LATENCY_MS still
# works as a fallback for this value.
INGEST_SRT_INGRESS_LATENCY_MS=4000
# SRT receiver-buffer latency (ms) on the output listener (server -> OBS over
# the tailnet). Must match the OBS Media Source `latency=` query param — SRT
# negotiates the higher of the two sides.
INGEST_SRT_EGRESS_LATENCY_MS=300
# Read PES timestamps off the relayed MPEG-TS and report the audio/video skew
# the streamer's encoder sent (av_skew_ms and friends, on the ingest_stream
# measurement). Costs ~0.04% of a core at 4 Mbps and runs off the forwarding
# path. Set false to disable.
INGEST_AV_SYNC_ENABLED=true
# Seconds to wait for control plane before rejecting a connection
INGEST_CONTROL_TIMEOUT=5
# Log level for the media plane (DEBUG, INFO, WARNING, ERROR)
INGEST_LOG_LEVEL=INFO

# ── Network ──────────────────────────────────────────────────
# Tailscale IP of this VPS — the SRT output port is bound to this interface
# so it is never exposed to the public internet. Run: tailscale ip -4
TAILSCALE_IP=

# ── InfluxDB (optional) ───────────────────────────────────────
# Time-series sink for per-stream ingest metrics + host system metrics
# (CPU/RAM/bandwidth). All three vars must be set to enable; omit or leave
# blank to disable metrics entirely. One shared InfluxDB instance with an org
# per environment — set ORG to streamwizard-dev / streamwizard-staging /
# streamwizard-prod to match this node's environment. The bucket is fixed
# ("ingest-nodes"); the token is a node-scoped write token for that bucket.
INFLUXDB_URL=
INFLUXDB_TOKEN=
INFLUXDB_ORG=

# ── Image tag ────────────────────────────────────────────────
# Which GHCR image tag docker-compose.yml pulls (ghcr.io/streamwizard/*).
# Leave blank to track :latest. Set to e.g. sha-abc1234 to pin this node to
# a specific build without editing docker-compose.yml.
INGEST_IMAGE_TAG=
