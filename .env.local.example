# Written by scripts/local/claim.sh; copy by hand only if you claim a node
# some other way. Used by docker/stream-server/docker-compose.local.yml (see
# scripts/local/up.sh).

NODE_ENV=development

# ── From POST /api/ingest-nodes/claim ─────────────────────────────────────────
INGEST_NODE_ID=
NODE_API_KEY=
INGEST_CONTROL_SECRET=

# ── Host services, as seen from inside the containers ────────────────────────
REST_API_URL=http://host.docker.internal:8080
INFLUXDB_URL=
INFLUXDB_TOKEN=
INFLUXDB_ORG=

# ── Compose ───────────────────────────────────────────────────────────────────
# No Tailscale locally: the control /health port and the OBS output port bind
# to loopback instead. OBS on this machine pulls srt://127.0.0.1:9000.
TAILSCALE_IP=127.0.0.1

# ── Same defaults install.sh writes ──────────────────────────────────────────
PORT=8090
INGEST_CONTROL_URL=http://ingest-control:8090
INGEST_SRT_PORT=8888
INGEST_SRTLA_SRT_PORT=8889
INGEST_OUTPUT_PORT=9000
INGEST_SRT_INGRESS_LATENCY_MS=4000
INGEST_SRT_EGRESS_LATENCY_MS=300
INGEST_CONTROL_TIMEOUT=5
INGEST_LOG_LEVEL=DEBUG
